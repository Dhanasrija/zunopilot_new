# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_automation?schema=public

# ── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED, no default, at least 32 characters. The API refuses to start
# otherwise. Every customer session is signed with this, so a weak or absent
# value is not a degraded state — it lets anyone mint a token for any user of
# any tenant. It used to fall back to 'dev-secret-change-me', which meant a
# missing variable booted silently and signed sessions with a string published
# in this repository. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ── Meta / WhatsApp ──────────────────────────────────────────────────────────
# META_APP_SECRET is REQUIRED in any deployed environment. POST /api/webhook is
# unauthenticated by design — Meta cannot present a token — so the
# X-Hub-Signature-256 HMAC computed with this secret is the ONLY thing that
# distinguishes a real inbound message from a forged one. Without it, anyone can
# invent customers, orders and automation triggers for any tenant.
#
# META_WEBHOOK_VERIFY_TOKEN gates only the subscribe handshake. It has no
# default (it used to be 'verify-token'); when empty the handshake always fails.
META_APP_ID=your-meta-app-id
META_APP_SECRET=
META_CONFIG_ID=your-embedded-signup-config-id
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

# Accept webhook POSTs with no valid signature. LOCAL DEVELOPMENT ONLY — it
# turns the endpoint above into an open write API for every tenant. Signature
# verification fails closed when META_APP_SECRET is unset unless this is
# explicitly 'true', so leaving it unset is the safe state everywhere.
ALLOW_UNSIGNED_WEBHOOKS=false
# Six-digit two-step PIN used to register onboarded numbers for Cloud API sending
# (POST /{phone_number_id}/register). If unset, registration is skipped and the
# embedded-signup response returns a warning instead.
META_DEFAULT_PHONE_PIN=

# ── The language model ───────────────────────────────────────────────────────
# Drives the intent router for inbound messages. Leave LLM_API_KEY blank to turn
# the router off entirely; automation then falls back to deterministic keyword
# matching. (Per-workspace control is separate — see the AI agent switch.)
#
# The router is the slowest thing a customer waits on: measured p50 1.5-2.0s,
# p95 3.1s, against ~2.65s end to end. The model dominates, which is why these
# are config and not constants.
# ── Choosing a vendor ────────────────────────────────────────────────────────
# Name a vendor and its own prefixed block is read; leave it empty and the
# unprefixed LLM_*/OPENAI_* pair below is used, exactly as before this existed.
#
#   LLM_VENDOR=groq   ->  GROQ_LLM_API_KEY, GROQ_LLM_MODEL, GROQ_LLM_BASE_URL,
#                         GROQ_LLM_STRUCTURED_MODE, GROQ_LLM_EXTRA_BODY,
#                         GROQ_LLM_TIMEOUT_MS
#   LLM_VENDOR=openai ->  OPENAI_LLM_* first, then the plain OPENAI_* names that
#                         are already deployed, so nothing needs renaming.
#
# Adding a vendor is a new prefixed block and one line here — no code change.
#
# A NAMED VENDOR NEVER BORROWS ANOTHER VENDOR'S KEY. With LLM_VENDOR=groq and no
# GROQ_LLM_API_KEY, the router goes to `mock` and logs why; it does not quietly
# fall through to OPENAI_API_KEY and bill the wrong vendor while appearing fine.
LLM_VENDOR=

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000

# An OpenAI-compatible endpoint, or blank for OpenAI's own. Groq and Google both
# offer one, so changing vendor is these two lines and no code:
#
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#           LLM_MODEL=llama-3.3-70b-versatile
#           LLM_STRUCTURED_MODE=json_object
#
# Note that distance usually beats raw inference speed here. From Mumbai, a US
# endpoint costs ~200-250ms of round trip before the first token, so the fastest
# model on paper is not automatically the fastest reply. Measure it:
#   npx tsx scripts/llm-bench.ts --tenant "<business name>" --yes
LLM_BASE_URL=

# How structured output is requested, and the one genuinely non-portable choice.
# `json_schema` is OpenAI's strict constrained decoding — the model cannot emit a
# shape that fails the schema. Support elsewhere is model-dependent, so
# `json_object` asks for valid JSON and puts the schema in the prompt instead.
# Weaker: the router can then receive well-formed JSON of the wrong shape. That
# is survivable because the reply is Zod-validated and anything malformed becomes
# "no match" rather than an error — a duller router, not a broken one.
LLM_STRUCTURED_MODE=json_schema

# Vendor-specific request fields, as JSON, merged into every completion. An escape
# hatch, because "OpenAI-compatible" stops at the common fields and each vendor's
# most useful knob is its own. Malformed JSON fails at boot rather than silently
# doing nothing.
#
# The one that prompted it: Gemini 2.5 Flash reasons before answering by default —
# 60 reasoning tokens for a six-token classification, and p50 3073ms vs 1319ms with
# it off. For a router doing classification that is latency spent on nothing:
#   LLM_EXTRA_BODY={"extra_body":{"google":{"thinking_config":{"thinking_budget":0}}}}
LLM_EXTRA_BODY=

# The OpenAI block. Historically "legacy aliases"; now also the vendor block that
# LLM_VENDOR=openai selects, so keeping a funded key here is a real second vendor
# rather than a leftover. OPENAI_BASE_URL is read by env.ts and was undocumented;
# blank means OpenAI's own endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=

# Logging
LOG_LEVEL=info

# 32-byte key (base64) sealing connector credentials at rest.
# Generate with: openssl rand -base64 32
# Deliberately has no default — a shared fallback key would look like
# encryption while protecting nothing.
ENCRYPTION_KEY=

# Outbound connector calls (the SSRF guard).
EGRESS_TIMEOUT_MS=8000
EGRESS_MAX_RESPONSE_BYTES=524288
# Never enable in a deployed environment: cloud metadata lives on a link-local
# address, and this is what keeps a tenant-authored base URL away from it.
EGRESS_ALLOW_PRIVATE_ADDRESSES=false

# ── GST ──────────────────────────────────────────────────────────────────────
# Identity only. The 18% rate is a constant in billing/gst.ts, because a rate an
# env var could change is a rate nobody approved.
#
# Until COMPANY_GSTIN is set, no tax is charged and invoices keep saying
# "applicable taxes are billed separately" — which is the truthful thing to say
# when we cannot legally show a tax number. Once set, GST is added on top of the
# listed price, so the Razorpay plans must be re-created:
#   npx tsx scripts/razorpay-plans.ts --dry-run     # see the new amounts first
#
# COMPANY_STATE_CODE is only a fallback: the GSTIN's first two digits win when
# both are present. 36 is Telangana.
COMPANY_GSTIN=
COMPANY_STATE_CODE=36

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Plan ids are read here and never accepted from a request, so a browser cannot
# name the plan it would like to be charged for.
# Without keys, checkout refuses cleanly and an administrator can still assign
# a plan manually (which is also how Enterprise works).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RAZORPAY_STARTER_MONTHLY_PLAN_ID=
RAZORPAY_STARTER_QUARTERLY_PLAN_ID=
RAZORPAY_STARTER_YEARLY_PLAN_ID=
RAZORPAY_GROWTH_MONTHLY_PLAN_ID=
RAZORPAY_GROWTH_QUARTERLY_PLAN_ID=
RAZORPAY_GROWTH_YEARLY_PLAN_ID=
RAZORPAY_BUSINESS_MONTHLY_PLAN_ID=
RAZORPAY_BUSINESS_QUARTERLY_PLAN_ID=
RAZORPAY_BUSINESS_YEARLY_PLAN_ID=

# ── Super admin ──────────────────────────────────────────────────────────────
# The operator console runs as its own process on its own port, so it can be
# firewalled or put behind a VPN without touching the customer-facing API.
#
# SUPERADMIN_JWT_SECRET has no default and must be at least 32 characters: the
# API refuses to start without one. It is deliberately NOT the same as
# JWT_SECRET — sharing it would make a customer token and an operator token
# interchangeable. Generate with: openssl rand -base64 48
SUPERADMIN_JWT_SECRET=
SUPERADMIN_PORT=4001
SUPERADMIN_ORIGIN=http://localhost:5174
# Optional; the seed generates a password when SUPERADMIN_PASSWORD is unset.
SUPERADMIN_EMAIL=superadmin@zunopilot.com
SUPERADMIN_NAME=ZunoPilot Super Admin

# ── OTP login ────────────────────────────────────────────────────────────────
# Customers sign in with a phone number and a one-time code. No password.
#
# OTP_ECHO returns the code in the API response so local testing does not spend
# real SMS. It is a COMPLETE AUTHENTICATION BYPASS — anyone could request a code
# for any number and read it back — so it is refused when NODE_ENV=production
# regardless of this value, and logged as an error if set there.
OTP_ECHO=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=45

# TextSpeed sends the real codes. Without a key, requesting an OTP still
# succeeds but no SMS is delivered — see services/sms.service.ts, and note the
# DLT template there must match the operator's registration byte for byte or
# delivery is dropped AFTER a Success response and a billed credit.
TEXTSPEEDAPIKEY=

# ── App Store / Play review login ────────────────────────────────────────────
# One phone number that signs in with a fixed code, because a store reviewer has
# neither the handset nor the number. THIS IS AN AUTHENTICATION BYPASS: see
# services/review-login.ts, which is its own file so `grep` answers "what can log
# in without a code being sent" with a filename.
#
# Both must be set or the feature stays off — a half-set pair is refused, so an
# empty code can never mean "an empty code is accepted". The code must be 6 to 8
# digits: a 4-digit code falls to guessing in about eight days against the
# 25-attempts-per-hour limit, so 4 and 5 are refused and the bypass disables
# itself with an error in the log.
#
# Point it at a number that is not and will never be a real customer's.
PRODOTPTESTNUMBER=
PRODOTPFORTEST=

# ── Web Push ─────────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# The public key also goes in the frontend as VITE_VAPID_PUBLIC_KEY. Rotating
# these invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@zunopilot.com

# ── Storage and workers ──────────────────────────────────────────────────────
# Where uploaded template media is written. Defaults to .media under the process
# working directory, which in a container without a mounted volume means every
# upload is lost on redeploy and campaigns referencing it break. Point this at
# persistent storage in production.
MEDIA_DIR=

# Run the pg-boss job workers inside the API process. Safe with several API
# instances — pg-boss locks each job and the scheduled entries use a singleton
# key — but every replica then polls every queue. Set false when running a
# separate worker process.
RUN_WORKERS_IN_API=true

# Poll loops for the inbound queue. pg-boss defaults this to 1, which capped the
# whole platform at roughly 65 messages a minute no matter how many tenants were
# sending. Size it against the Prisma pool, not the CPU count: inbound work is
# almost all waiting on Postgres, OpenAI and Meta. Keep INBOUND_CONCURRENCY x 2
# comfortably under connection_limit — see docs/production.md.
INBOUND_CONCURRENCY=4

# Ceiling on a single Graph API call. Axios has no default timeout, and a stalled
# socket to Meta inside an inbound job used to stop the queue for every tenant.
META_TIMEOUT_MS=10000

# ── A vendor block, as an example ────────────────────────────────────────────
# Selected by LLM_VENDOR=groq above. scripts/llm-bench.ts also reads these four
# directly for `--provider groq`, which is why they use this naming.
GROQ_LLM_API_KEY=
GROQ_LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_LLM_STRUCTURED_MODE=json_object

# Point pg-boss at its own database. Optional; falls back to DATABASE_URL. Worth
# splitting in production — the queue is the heaviest writer in the system, and
# its vacuum load has nothing to do with customer queries.
QUEUE_DATABASE_URL=

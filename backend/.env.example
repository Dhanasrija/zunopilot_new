# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_automation?schema=public

# JWT
JWT_SECRET=replace-me-with-a-strong-secret
JWT_EXPIRES_IN=1d

# Meta / WhatsApp
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_CONFIG_ID=your-embedded-signup-config-id
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=replace-me-webhook-verify-token

# Logging
LOG_LEVEL=info

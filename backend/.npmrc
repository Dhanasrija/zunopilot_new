# A lockfile is not optional here: CI runs `npm ci`, which refuses to run without one.
#
# This exists because a global `package-lock=false` in ~/.npmrc silently won a whole
# afternoon. With it set, `npm install` writes no lockfile at all, so the only way to
# refresh one is `npm install --package-lock-only` — and THAT mode resolves optional
# dependencies for the host platform only. The superadmin lockfile came out with just
# `@rollup/rollup-darwin-arm64` recorded and none of the other 24 platforms, so
# `npm ci` on a Linux runner installed a rollup that could not load its own binary.
#
# Project config beats user config, so this pins the behaviour to the repo instead of
# to whoever's laptop last touched a dependency.
package-lock=true

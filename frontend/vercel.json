{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/features/shared-whatsapp-portal",
      "destination": "/features/whatsapp-team-inbox",
      "permanent": true
    },
    {
      "source": "/whatsapp-business-api",
      "destination": "/features/whatsapp-business-api",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.zunopilot.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://api.zunopilot.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
